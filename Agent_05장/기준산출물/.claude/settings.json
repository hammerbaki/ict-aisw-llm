{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python ops/rules/*)",
      "Bash(python tools/test_guard.py check)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch -c *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "Edit(./tests/**)",
      "Edit(./requirements.txt)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./CODEOWNERS)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Edit(./data/**)",
      "Edit(./tests/.baseline.json)",
      "Edit(./pytest.ini)",
      "Edit(conftest.py)",
      "Edit(./tools/test_guard.py)",
      "Bash(* tools/test_guard.py freeze*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git commit *--no-verify*)",
      "Bash(rm -rf *)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
