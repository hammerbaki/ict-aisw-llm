# 이 파일을 .env로 복사해 값을 채운다. .env는 저장소에 올리지 않는다(.gitignore).
# 이 파일(.env.example)에는 실제 값을 적지 않는다.

# 1이면 LLM을 부르지 않고 모의 응답을 쓴다. 테스트와 첫 실행은 1로 한다.
LLM_FAKE=1

# 실제 호출에 쓸 모델 이름. 수업 직전에 공식 모델 목록에서 확인한 값을 쓴다.
# https://platform.claude.com/docs/en/about-claude/models/overview (2026-11-14 확인: 가장 저렴한 모델은 claude-haiku-5-5)
LLM_MODEL=claude-haiku-5-5

# 실제 호출에 쓸 API 키(선택). 실습은 모의 모드가 기본이며 키 없이 끝까지 돈다.
# 실제로 불러 보려면 각자 Claude Console에서 발급한 키를 넣는다(부록 A-2-3, A-11).
# 브라우저 코드나 저장소에 넣지 않는다. 키가 새어 나갔으면 Console에서 바로 폐기한다.
ANTHROPIC_API_KEY=

# 프롬프트 판본(prompts/ 폴더의 파일 이름)
PROMPT_SUMMARY=summary_v1
PROMPT_ASK=ask_v1

# 임베딩: auto(Ollama가 있으면 쓰고 없으면 대체 구현), ollama, fallback
EMBED_BACKEND=auto
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# 질의응답에서 근거로 인정할 최소 유사도. 비워 두면 임베딩 방식별 기본값을 쓴다.
# ASK_MIN_SCORE=0.3

# 값을 정하면 그 폴더에 access.log, error.log, llm.log를 남긴다.
# LOG_DIR=logs/runtime
