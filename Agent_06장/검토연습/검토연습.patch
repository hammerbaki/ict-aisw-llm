--- /dev/null
+++ b/tests/test_report.py
@@ -0,0 +1,21 @@
+"""ops/daily_report.py의 집계 테스트. LLM을 부르지 않는다."""
+
+from pathlib import Path
+
+from ops.daily_report import count_status
+
+LINES = [
+    "2027-09-08 14:00:01 INFO jobprep.access method=POST path=/api/summary status=503 ms=40",
+    "2027-09-08 14:00:09 INFO jobprep.access method=GET path=/api/jobs status=200 ms=12",
+    "2027-09-09 09:00:00 INFO jobprep.access method=GET path=/api/jobs status=200 ms=10",
+]
+
+
+def test_count_status_counts_only_that_day():
+    assert count_status(LINES, "2027-09-08") == {"200": 1, "503": 1}
+
+
+def test_count_status_reads_sample_log():
+    lines = Path("logs/access.log").read_text(encoding="utf-8").splitlines()
+    counts = count_status(lines, "2027-09-08")
+    assert counts["503"] == 7
