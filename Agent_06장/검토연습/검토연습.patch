+const MEMO_KEY = "jobprep.memos";
+
+function loadMemo(id) {
+  try {
+    return (JSON.parse(localStorage.getItem(MEMO_KEY)) || {})[id] || "";
+  } catch {
+    return "";
+  }
+}
+
+function saveMemo(id, text) {
+  let memos = {};
+  try {
+    memos = JSON.parse(localStorage.getItem(MEMO_KEY)) || {};
+  } catch {
