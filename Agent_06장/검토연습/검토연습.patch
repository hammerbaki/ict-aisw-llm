+# 운영 스크립트
+
+| 파일 | 하는 일 |
+|---|---|
+| `daily_report.py` | `logs/access.log`에서 하루치 상태 코드를 세어 출력한다. `REPORT_WITH_LLM=1`이면 한 문단 요약을 덧붙인다 |
+
+실행은 저장소 폴더에서 `python -m ops.daily_report 2027-09-08`로 한다.
diff --git a/ops/daily_report.py b/ops/daily_report.py
new file mode 100644
index 0000000000000000000000000000000000000000..ce326e8b1b09935638ca34da87a6427590ba11a9
--- /dev/null
+++ b/ops/daily_report.py
@@ -0,0 +1,53 @@
+"""운영 기록(logs/access.log)을 읽어 하루치 상태 코드 집계와 한 문단 요약을 만든다.
+
+실행: python -m ops.daily_report 2027-09-08
+집계는 count_status()가 하고, 문단 요약은 REPORT_WITH_LLM=1일 때만 LLM에 맡긴다.
+"""
+
+import collections
+import os
+import re
+import sys
+from pathlib import Path
+
+import anthropic
+
+LOG_DIR = Path(os.environ.get("REPORT_LOG_DIR", "logs"))
+API_KEY = "sk-ant-api03-FAKE-REVIEW-DRILL-0000000000"  # 운영 보고 전용 키
+STATUS = re.compile(r"status=(\d{3})")
+
+
+def count_status(lines, day):
+    """그날의 요청 기록에서 상태 코드별 건수를 센다."""
+    counts = collections.Counter()
+    for line in lines:
+        if not line.startswith(day):
+            continue
+        match = STATUS.search(line)
+        if match:
+            counts[match.group(1)] += 1
+    return dict(sorted(counts.items()))
+
+
+def summarize_counts(day, counts):
+    """집계를 LLM에 보내 운영자가 읽을 한 문단으로 바꾼다."""
+    client = anthropic.Anthropic(api_key=API_KEY)
+    response = client.messages.create(
+        model="claude-haiku-5-5",
+        max_tokens=512,
+        messages=[{"role": "user", "content": f"{day}의 상태 코드 집계 {counts}를 운영자에게 한 문단으로 보고하라."}],
+    )
+    return response.content[0].text
+
+
+def main():
+    day = sys.argv[1] if len(sys.argv) > 1 else "2027-09-08"
+    lines = (LOG_DIR / "access.log").read_text(encoding="utf-8").splitlines()
+    counts = count_status(lines, day)
+    print(f"{day} 상태 코드 집계: {counts}")
+    if os.environ.get("REPORT_WITH_LLM") == "1":
+        print(summarize_counts(day, counts))
+
+
+if __name__ == "__main__":
+    main()
