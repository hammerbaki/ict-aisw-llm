      {
        "startedDateTime": "2026-11-18T11:23:48.198Z",
        "time": 5.879,
        "request": {
          "method": "GET",
          "url": "http://localhost:8200/app.js",
          "httpVersion": "HTTP/1.1",
          "cookies": [],
          "headers": [
            {
              "name": "Host",
              "value": "localhost:8200"
            },
            {
              "name": "Accept",
              "value": "*/*"
            }
          ],
          "queryString": [],
          "headersSize": -1,
          "bodySize": 0
        },
        "response": {
          "status": 200,
          "statusText": "OK",
          "httpVersion": "HTTP/1.1",
          "cookies": [],
          "headers": [
            {
              "name": "Server",
              "value": "StudyRoomDemo/1.0 Python/3.13.7"
            },
            {
              "name": "Date",
              "value": "Wed, 18 Nov 2026 11:23:48 GMT"
            },
            {
              "name": "Content-Type",
              "value": "text/javascript; charset=utf-8"
            },
            {
              "name": "Content-Length",
              "value": "3653"
            }
          ],
          "content": {
            "size": 3653,
            "mimeType": "text/javascript; charset=utf-8",
            "text": "// 스터디룸 예약 화면. 서버의 /api/ 끝점만 부른다.\nconst $ = (id) => document.getElementById(id);\nlet rooms = [];\n\nfunction times() {\n  const out = [];\n  for (let h = 9; h <= 21; h++) {\n    for (const m of [\"00\", \"30\"]) {\n      if (h === 21 && m === \"30\") continue;\n      out.push(String(h).padStart(2, \"0\") + \":\" + m);\n    }\n  }\n  return out;\n}\n\nfunction fill(select, values, labels) {\n  select.replaceChildren();\n  values.forEach((v, i) => {\n    const o = document.createElement(\"option\");\n    o.value = v;\n    o.textContent = labels ? labels[i] : v;\n    select.append(o);\n  });\n}\n\nfunction say(text, kind) {\n  $(\"message\").textContent = text;\n  $(\"message\").className = kind || \"\";\n}\n\nasync function loadRooms() {\n  const res = await fetch(\"/api/rooms\");\n  rooms = await res.json();\n  fill($(\"room\"), rooms.map((r) => r.id), rooms.map((r) => `${r.name} (${r.capacity}명)`));\n}\n\nasync function loadReservations() {\n  const res = await fetch(\"/api/reservations?date=\" + encodeURIComponent($(\"date\").value));\n  if (!res.ok) {\n    say(\"목록을 읽지 못했다. 날짜를 확인한다.\", \"error\");\n    return;\n  }\n  const list = await res.json();\n  const body = $(\"rows\");\n  body.replaceChildren();\n  $(\"empty\").hidden = list.length > 0;\n  for (const r of list) {\n    const tr = document.createElement(\"tr\");\n    const room = rooms.find((x) => x.id === r.room_id);\n    for (const text of [room ? room.name : r.room_id, `${r.start}~${r.end}`, r.name]) {\n      const td = document.createElement(\"td\");\n      td.textContent = text;\n      tr.append(td);\n    }\n    const td = document.createElement(\"td\");\n    const b = document.createElement(\"button\");\n    b.textContent = \"취소\";\n    b.addEventListener(\"click\", () => cancel(r.id));\n    td.append(b);\n    tr.append(td);\n    body.append(tr);\n  }\n}\n\nasync function reserve(event) {\n  event.preventDefault();\n  const start = $(\"start\").value;\n  const end = $(\"end\").value;\n  // 화면의 검사는 편의이다. 같은 규칙을 서버도 판정한다.\n  if (end <= start) {\n    say(\"끝 시각은 시작 시각보다 뒤여야 한다.\", \"error\");\n    return;\n  }\n  const res = await fetch(\"/api/reservations\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({\n      room_id: Number($(\"room\").value),\n      date: $(\"date\").value,\n      start,\n      end,\n      name: $(\"name\").value,\n    }),\n  });\n  if (res.status === 201) {\n    say(\"예약하였다.\", \"ok\");\n  } else if (res.status === 409) {\n    say(\"그 시간에는 이미 예약이 있다. 다른 시간을 고른다.\", \"error\");\n  } else {\n    const data = await res.json().catch(() => ({}));\n    say(\"예약하지 못했다: \" + (data.detail || res.status), \"error\");\n  }\n  await loadReservations();\n}\n\nasync function cancel(id) {\n  const res = await fetch(\"/api/reservations/\" + id, { method: \"DELETE\" });\n  if (res.status === 204) {\n    say(\"취소하였다.\", \"ok\");\n  } else if (res.status === 404) {\n    say(\"이미 취소되었거나 없는 예약이다. 목록을 다시 읽었다.\", \"error\");\n  } else {\n    say(\"취소하지 못했다: \" + res.status, \"error\");\n  }\n  await loadReservations();\n}\n\nasync function main() {\n  const t = times();\n  fill($(\"start\"), t);\n  fill($(\"end\"), t);\n  $(\"start\").value = \"10:00\";\n  $(\"end\").value = \"11:00\";\n  const d = new Date();\n  $(\"date\").value = [d.getFullYear(), String(d.getMonth() + 1).padStart(2, \"0\"),\n    String(d.getDate()).padStart(2, \"0\")].join(\"-\");\n  $(\"date\").addEventListener(\"change\", loadReservations);\n  $(\"form\").addEventListener(\"submit\", reserve);\n  await loadRooms();\n  await loadReservations();\n}\n\nmain();\n"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 3653
        },
