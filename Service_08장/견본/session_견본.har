          ],
          "content": {
            "size": 1401,
            "mimeType": "text/html; charset=utf-8",
            "text": "<!doctype html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>스터디룸 예약</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <header>\n    <h1>스터디룸 예약</h1>\n    <p class=\"note\">8장 예제 웹앱. 이름 칸에는 지어낸 값만 쓴다.</p>\n  </header>\n\n  <main>\n    <section aria-labelledby=\"pick\">\n      <h2 id=\"pick\">날짜</h2>\n      <label>날짜 <input type=\"date\" id=\"date\"></label>\n    </section>\n\n    <section aria-labelledby=\"new\">\n      <h2 id=\"new\">새 예약</h2>\n      <form id=\"form\">\n        <label>방 <select id=\"room\"></select></label>\n        <label>시작 <select id=\"start\"></select></label>\n        <label>끝 <select id=\"end\"></select></label>\n        <label>이름 <input id=\"name\" maxlength=\"20\" required placeholder=\"예: 연습\"></label>\n        <button type=\"submit\">예약</button>\n      </form>\n      <p id=\"message\" role=\"status\"></p>\n    </section>\n\n    <section aria-labelledby=\"list\">\n      <h2 id=\"list\">그날의 예약</h2>\n      <table>\n        <thead><tr><th>방</th><th>시간</th><th>이름</th><th></th></tr></thead>\n        <tbody id=\"rows\"></tbody>\n      </table>\n      <p id=\"empty\" hidden>이 날짜에는 아직 예약이 없다. 위에서 예약한다.</p>\n    </section>\n  </main>\n\n  <script src=\"app.js\"></script>\n</body>\n</html>\n"
          },
          "redirectURL": "",
          "headersSize": -1,
          "bodySize": 1401
