          "content": {
            "size": 705,
            "mimeType": "text/css; charset=utf-8",
            "text": "body { font-family: system-ui, sans-serif; margin: 0 auto; max-width: 720px; padding: 16px; color: #222; background: #fff; }\nh1 { font-size: 1.5rem; margin-bottom: 0; }\nh2 { font-size: 1.1rem; margin-top: 1.5rem; }\n.note { color: #666; margin-top: 4px; }\nform { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; }\nlabel { display: inline-flex; gap: 6px; align-items: center; }\ninput, select, button { font: inherit; padding: 4px 6px; }\nbutton { cursor: pointer; }\ntable { border-collapse: collapse; width: 100%; }\nth, td { border-bottom: 1px solid #ddd; padding: 6px; text-align: left; }\n#message { min-height: 1.5em; }\n#message.error { color: #b00020; }\n#message.ok { color: #1b5e20; }\n"
          },
